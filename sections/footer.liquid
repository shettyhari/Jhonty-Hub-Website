<footer class="mega-footer" style="background: var(--bg-surface); border-top: 1px solid var(--border-glass); padding-top: 4rem; padding-bottom: 3rem;">
  <div class="container">
    
    <!-- Brand Identity Strip in Footer -->
    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; margin-bottom: 3.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--border-glass);">
      <div style="filter: drop-shadow(0 0 20px rgba(212,175,55,0.45)); margin-bottom: 1rem;">
        {% render 'icon-logo' %}
      </div>
      <h3 style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 900; letter-spacing: 0.22em; margin-bottom: 0.25rem;">
        <span style="background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">JHONTY HUB</span>
      </h3>
      <p style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.35em; text-transform: uppercase; color: var(--gold-primary); margin-bottom: 1rem;">
        TRENDSETTING MEN'S STREETWEAR &bull; HYDERABAD &bull; EST. 2024
      </p>
      <p style="max-width: 580px; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; margin: 0 auto;">
        Hyderabad's premier destination for heavyweight drop-shoulder oversized tees, imported Korean satin shirts, baggy Japanese denim, chunky street sneakers, and exclusive hype drops.
      </p>
    </div>

    <!-- Flagship Stores in Hyderabad Strip -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 3.5rem; padding: 2rem; background: rgba(212,175,55,0.05); border: 1px solid var(--border-gold); border-radius: 16px;">
      <div>
        <div style="font-size: 0.7rem; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-primary); margin-bottom: 4px;">Flagship 01</div>
        <h4 style="font-weight: 800; margin-bottom: 6px;">Kukatpally Store (Hyderabad)</h4>
        <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5;">Venkata Ramana Colony, Near Metro Station Pillar, Kukatpally, Hyderabad, Telangana 500072.</p>
        <div style="margin-top: 8px; font-size: 0.75rem; font-weight: 700; color: var(--gold-primary);">📞 +91 91606 63888</div>
      </div>
      <div>
        <div style="font-size: 0.7rem; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-primary); margin-bottom: 4px;">Studio 02</div>
        <h4 style="font-weight: 800; margin-bottom: 6px;">Madhapur Atelier (Hyderabad)</h4>
        <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5;">Hitech City Main Road, Opp. Inorbit Mall Driveway, Madhapur, Hyderabad, Telangana 500081.</p>
        <div style="margin-top: 8px; font-size: 0.75rem; font-weight: 700; color: var(--gold-primary);">📞 +91 91606 61888</div>
      </div>
      <div>
        <div style="font-size: 0.7rem; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-primary); margin-bottom: 4px;">Branch 03</div>
        <h4 style="font-weight: 800; margin-bottom: 6px;">LB Nagar Store (Hyderabad)</h4>
        <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5;">B.N. Reddy Nagar, Sagar Ring Road Junction, LB Nagar, Hyderabad, Telangana 500079.</p>
        <div style="margin-top: 8px; font-size: 0.75rem; font-weight: 700; color: var(--gold-primary);">📞 +91 91606 63888</div>
      </div>
    </div>

    <!-- Newsletter Strip -->
    <div class="footer-newsletter-banner" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-glass); border-radius: 20px; padding: 2rem; margin-bottom: 3rem;">
      <div>
        <h4 style="font-family: var(--font-serif); color: var(--text-primary); font-size: 1.35rem; font-weight: 800; margin-bottom: 6px;">Jhonty Hub VIP Drop Club</h4>
        <p style="font-size: 0.85rem; color: var(--text-secondary);">Get instant WhatsApp/SMS notification 1 hour before our limited weekly drops go live.</p>
      </div>
      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('You are now on the Jhonty Hub VIP Drop List!');">
        <input type="tel" placeholder="Enter your WhatsApp number (+91)" required style="background: var(--bg-deep); border: 1px solid var(--border-glass); color: var(--text-primary); padding: 12px 20px; border-radius: 9999px;">
        <button type="submit" class="btn-gold-shimmer" style="padding: 12px 28px; border-radius: 9999px; font-weight: 800; font-family: var(--font-serif); letter-spacing: 0.1em; cursor: pointer;">JOIN VIP LIST</button>
      </form>
    </div>

    <!-- Sitemap Columns -->
    <div class="footer-sitemap-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
      <div class="footer-col">
        <h5 style="color: var(--text-primary); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 1rem;">Streetwear Apparel</h5>
        <ul style="list-style: none; padding: 0; line-height: 2;">
          <li><a href="/collections/oversized-tees" style="color: var(--text-secondary); text-decoration: none;">Heavyweight Boxy Tees</a></li>
