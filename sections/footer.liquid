          <li><a href="/collections/korean-shirts" style="color: var(--text-secondary); text-decoration: none;">Korean Satin &amp; Cuban Shirts</a></li>
          <li><a href="/collections/baggy-jeans" style="color: var(--text-secondary); text-decoration: none;">Skater Baggy Denim</a></li>
          <li><a href="/collections/cargos" style="color: var(--text-secondary); text-decoration: none;">Tactical Parachute Cargos</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5 style="color: var(--text-primary); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 1rem;">Footwear &amp; Kicks</h5>
        <ul style="list-style: none; padding: 0; line-height: 2;">
          <li><a href="/collections/sneakers" style="color: var(--text-secondary); text-decoration: none;">Chunky Platform Runners</a></li>
          <li><a href="/collections/high-tops" style="color: var(--text-secondary); text-decoration: none;">High-Top Street Sneakers</a></li>
          <li><a href="/collections/slides" style="color: var(--text-secondary); text-decoration: none;">Suede Mules &amp; Slides</a></li>
          <li><a href="/collections/jackets" style="color: var(--text-secondary); text-decoration: none;">Varsity Bomber Jackets</a></li>
          <li><a href="/collections/hoodies" style="color: var(--text-secondary); text-decoration: none;">French Terry Heavy Hoodies</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5 style="color: var(--text-primary); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 1rem;">Customer Support</h5>
        <ul style="list-style: none; padding: 0; line-height: 2;">
          <li><a href="/pages/order-tracking" style="color: var(--text-secondary); text-decoration: none;">Track Courier Shipment</a></li>
          <li><a href="/pages/exchange-policy" style="color: var(--text-secondary); text-decoration: none;">7-Day Easy Exchange Policy</a></li>
          <li><a href="/pages/hyderabad-delivery" style="color: var(--text-secondary); text-decoration: none;">Same-Day Hyderabad Delivery</a></li>
          <li><a href="/pages/size-guide" style="color: var(--text-secondary); text-decoration: none;">Oversized Fit Guide</a></li>
          <li><a href="/pages/contact" style="color: var(--text-secondary); text-decoration: none;">WhatsApp Concierge Help</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5 style="color: var(--text-primary); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 1rem;">Jhonty Hub Stores</h5>
        <ul style="list-style: none; padding: 0; line-height: 2;">
          <li><a href="/pages/stores" style="color: var(--text-secondary); text-decoration: none;">Kukatpally Flagship</a></li>
          <li><a href="/pages/stores" style="color: var(--text-secondary); text-decoration: none;">Madhapur Atelier</a></li>
          <li><a href="/pages/stores" style="color: var(--text-secondary); text-decoration: none;">LB Nagar Branch</a></li>
          <li><a href="/pages/about" style="color: var(--text-secondary); text-decoration: none;">About Jhonty Hub Story</a></li>
          <li><a href="/pages/terms" style="color: var(--text-secondary); text-decoration: none;">Terms &amp; Authentic Guarantee</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright & Security Badges -->
    <div class="footer-bottom-row" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-glass); padding-top: 2rem; font-size: 0.75rem; color: var(--text-muted); gap: 1rem;">
      <div>
        &copy; {{ 'now' | date: "%Y" }} JHONTY HUB (JH) APPAREL &bull; Hyderabad, India. Built for Shopify OS 2.0.
      </div>
      <div style="display: flex; gap: 18px; align-items: center;">
        <span>🔒 100% Verified Secure UPI &amp; Cards</span>
        <span>&bull;</span>
        <span>PhonePe &bull; Google Pay &bull; Paytm &bull; Visa &bull; COD Available</span>
      </div>
    </div>

  </div>
