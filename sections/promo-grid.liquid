<div class="container" style="margin-top: 40px; margin-bottom: 40px;">
  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24px;">
    <div>
      <span style="font-size: 0.72rem; font-weight: 800; letter-spacing: 0.25em; text-transform: uppercase; color: var(--gold-primary);">The Jhonty Edit</span>
      <h2 style="font-family: var(--font-serif); font-size: 1.8rem; font-weight: 900; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 4px;">Featured Hype Drops</h2>
    </div>
    <a href="/collections/all" style="font-size: 0.82rem; font-weight: 800; color: var(--gold-primary); text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none;">Explore All Drops &rarr;</a>
  </div>

  <div class="promo-grid">
    <a href="/collections/oversized-tees" class="promo-tile card-3d-tilt">
      <img src="https://images.unsplash.com/photo-1576566588028-4147f3842f27?auto=format&fit=crop&w=600&q=80" alt="Graphic Tees">
      <div class="promo-tile__caption">
        <span class="promo-tile__tag">Starting ₹999</span>
        <h3 class="promo-tile__title">320 GSM Graphic Drop-Shoulders</h3>
      </div>
    </a>

    <a href="/collections/imported-shirts" class="promo-tile card-3d-tilt">
      <img src="https://images.unsplash.com/photo-1596755094514-f87e34085b2c?auto=format&fit=crop&w=600&q=80" alt="Korean Shirts">
      <div class="promo-tile__caption">
        <span class="promo-tile__tag">Flat 40% Off</span>
        <h3 class="promo-tile__title">Korean Liquid Satin &amp; Cuban Shirts</h3>
      </div>
    </a>

    <a href="/collections/baggy-denim" class="promo-tile card-3d-tilt">
      <img src="https://images.unsplash.com/photo-1541099649105-f69ad21f3246?auto=format&fit=crop&w=600&q=80" alt="Baggy Denim">
      <div class="promo-tile__caption">
        <span class="promo-tile__tag">Buy 2 Get ₹500 Off</span>
        <h3 class="promo-tile__title">Japanese Skater Wide-Leg Denim</h3>
      </div>
    </a>

    <a href="/collections/sneakers" class="promo-tile card-3d-tilt">
      <img src="https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=600&q=80" alt="Footwear">
      <div class="promo-tile__caption">
        <span class="promo-tile__tag">From ₹2,499</span>
        <h3 class="promo-tile__title">Chunky Platform Street Runners</h3>
      </div>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Jhonty Promotional Grid",
  "settings": [],
  "presets": [
    {
      "name": "Jhonty Promotional Grid"
    }
  ]
}
{% endschema %}