<section class="section-spacing" style="padding-top: 80px;">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 70px; align-items: start;">
      
      <!-- Gallery Column -->
      <div>
        <div class="glass-panel" style="padding: 16px; border-radius: 24px; margin-bottom: 20px;">
          <div style="position: relative; border-radius: 16px; overflow: hidden; aspect-ratio: 1/1; background: #000;">
            <img
              id="ProductMainImage"
              src="{{ product.featured_media | image_url: width: 1200 }}"
              alt="{{ product.featured_media.alt | escape }}"
              style="width: 100%; height: 100%; object-fit: cover;"
            >
            <span class="edition-tag" style="top: 20px; left: 20px;">Individually Numbered</span>
          </div>
        </div>

        {%- if product.media.size > 1 -%}
          <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px;">
            {%- for media in product.media -%}
              <div
                class="glass-panel product-gallery__thumb"
                data-image-src="{{ media | image_url: width: 1200 }}"
                style="padding: 6px; border-radius: 14px; cursor: pointer; aspect-ratio: 1/1; overflow: hidden;"
              >
                <img src="{{ media | image_url: width: 240 }}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;">
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Information & Acquisition Box -->
      <div style="display: flex; flex-direction: column; gap: 28px;">
        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
            <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: #d4af37; font-weight: 700;">
              Capsule Edition &bull; Atelier Reserve
            </span>
            <span class="stock-indicator-pill" style="position: static;">
              <span class="pulse-dot"></span>
              <span>Available for Private Commission</span>
            </span>
          </div>

          <h1 style="font-family: var(--font-serif); font-size: 3rem; font-weight: 700; line-height: 1.15; color: #ffffff;">
            {{ product.title }}
          </h1>

          <div style="margin-top: 18px; display: flex; align-items: baseline; gap: 14px;">
            <span style="font-family: var(--font-sans); font-size: 2.2rem; font-weight: 800; color: #ffffff;">
              {{ product.selected_or_first_available_variant.price | money }}
            </span>
            <span style="font-size: 0.85rem; color: #94a3b8; letter-spacing: 0.05em;">
              Inclusive of Insured White-Glove Transit
            </span>
          </div>
        </div>

        <hr style="border: 0; border-top: 1px solid var(--border-glass);">

        <!-- Purchase & Variant Actions -->
        {% form 'product', product, id: 'product-form' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 28px;">
            <div>
              <label style="display: block; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.15em; font-weight: 700; color: #cbd5e1; margin-bottom: 10px;">
                Material Finish
              </label>
              <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <button type="button" class="btn-glass" style="border-color: #d4af37; background: rgba(212, 175, 55, 0.12); color: #fff;">
                  Obsidian Black (Anodized)
                </button>
                <button type="button" class="btn-glass" style="border-color: rgba(255,255,255,0.15);">
                  Brushed Titanium Raw
                </button>
                <button type="button" class="btn-glass" style="border-color: rgba(255,255,255,0.15);">
                  Arctic Ceramic White
                </button>
              </div>
            </div>
          </div>

          <div style="display: flex; gap: 16px;">
            <button
              type="submit"
              name="add"
              class="btn-gold"
              style="flex-grow: 1; padding: 18px 36px; font-size: 0.9rem;"
            >
              Acquire for Vault &bull; Instant Dispatch
            </button>
          </div>
        {% endform %}

        <!-- Atelier Specifications & Physical Architecture -->
        <div class="glass-panel" style="padding: 24px; border-radius: 18px; display: flex; flex-direction: column; gap: 16px;">
          <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 12px;">
            <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: #94a3b8;">Chassis Material</span>
            <span style="font-weight: 700; color: #fff; font-size: 0.88rem;">6063-T6 Aerospace Aluminum</span>
          </div>
          <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 12px;">
            <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: #94a3b8;">Authentication</span>
            <span style="font-weight: 700; color: #d4af37; font-size: 0.88rem;">NFC Cryptographic Identity Plate</span>
          </div>
          <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 12px;">
            <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: #94a3b8;">Transit Courier</span>
            <span style="font-weight: 700; color: #fff; font-size: 0.88rem;">Direct Hand-Delivery (Insured)</span>
          </div>
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: #94a3b8;">Atelier Guarantee</span>
            <span style="font-weight: 700; color: #fff; font-size: 0.88rem;">Lifetime Repair Vault Coverage</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxury Product Hero",
  "settings": []
}
{% endschema %}
