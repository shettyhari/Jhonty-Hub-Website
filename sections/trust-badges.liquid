<section class="retail-trust-strip" style="background: var(--bg-surface); border-top: 1px solid var(--border-glass); border-bottom: 1px solid var(--border-glass); padding: 40px 0;">
  <div class="container">
    <div class="trust-strip-grid">
      <div class="trust-strip-item">
        <div class="trust-icon-circle" style="background: rgba(212,175,55,0.1); border: 1px solid var(--border-gold); color: var(--gold-primary); font-size: 1.3rem;">
          ⚡
        </div>
        <div class="trust-text">
          <h4 style="font-family: var(--font-serif); font-size: 0.95rem; font-weight: 800; color: var(--text-primary);">Same-Day Hyderabad Dispatch</h4>
          <p style="font-size: 0.8rem; color: var(--text-secondary);">Direct delivery across Hyderabad &amp; express 2-4 day pan-India</p>
        </div>
      </div>

      <div class="trust-strip-item">
        <div class="trust-icon-circle" style="background: rgba(212,175,55,0.1); border: 1px solid var(--border-gold); color: var(--gold-primary); font-size: 1.3rem;">
          🏬
        </div>
        <div class="trust-text">
          <h4 style="font-family: var(--font-serif); font-size: 0.95rem; font-weight: 800; color: var(--text-primary);">3 Hyderabad Flagships</h4>
          <p style="font-size: 0.8rem; color: var(--text-secondary);">Try before you buy at Kukatpally, Madhapur or LB Nagar</p>
        </div>
      </div>

      <div class="trust-strip-item">
        <div class="trust-icon-circle" style="background: rgba(212,175,55,0.1); border: 1px solid var(--border-gold); color: var(--gold-primary); font-size: 1.3rem;">
          🔄
        </div>
        <div class="trust-text">
          <h4 style="font-family: var(--font-serif); font-size: 0.95rem; font-weight: 800; color: var(--text-primary);">7-Day Easy Exchange</h4>
          <p style="font-size: 0.8rem; color: var(--text-secondary);">Hassle-free size replacement at any store or via courier</p>
        </div>
      </div>

      <div class="trust-strip-item">
        <div class="trust-icon-circle" style="background: rgba(212,175,55,0.1); border: 1px solid var(--border-gold); color: var(--gold-primary); font-size: 1.3rem;">
          🛡️
        </div>
        <div class="trust-text">
          <h4 style="font-family: var(--font-serif); font-size: 0.95rem; font-weight: 800; color: var(--text-primary);">100% Quality Checked Cotton</h4>
          <p style="font-size: 0.8rem; color: var(--text-secondary);">280-320 GSM combed bio-wash fabric engineered to last</p>
        </div>
      </div>
    </div>
  </div>
</section>

