{% comment %}
  Renders a product's price, including compare-at price and currency symbol.
  Usage:
  {% render 'price', product: product, use_variant: false %}
{% endcomment %}
{%- liquid
  if use_variant
    assign target = target_variant
  else
    assign target = product
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign available = target.available | default: false
  assign money_price = price | money
-%}

<div class="price-container">
  {%- if compare_at_price > price -%}
    <span class="price-regular">{{ money_price }}</span>
    <s class="price-compare">{{ compare_at_price | money }}</s>
    <span class="badge badge-sale">Save {{ compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round }}%</span>
  {%- else -%}
    <span class="price-regular">{{ money_price }}</span>
  {%- endif -%}
</div>
